{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/readability-check/hooks/readability_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/readability-check/hooks/readability_hook.py",
            "timeout": 15,
            "statusMessage": "Checking readability..."
          }
        ]
      }
    ]
  }
}
